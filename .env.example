# Copia este archivo a `.env` (que NO se sube a git) y rellena los valores reales.
# En produccion, estas variables viven en el dashboard de Netlify
# (Site settings > Environment variables) y en `netlify dev` se leen desde `.env`.

# Token de consultasperu.com para la funcion consultar-dni (netlify/functions/consultar-dni.ts).
CONSULTAS_PERU_TOKEN=

# Service account JSON de Firebase Admin SDK, en UNA sola linea.
# Se obtiene en Firebase Console > Project settings > Service accounts > Generate new private key.
# Las funciones serverless (cloudinary-sign, consultar-dni, confirm-reservation, etc.)
# fallan en local si esta variable no existe.
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Cloudinary: firman y suben las imagenes de platos/promociones
# (netlify/functions/cloudinary-sign.ts y src/app/services/image-upload.ts).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Secreto compartido con n8n para el webhook confirm-reservation (netlify/functions/confirm-reservation.ts).
N8N_WEBHOOK_SECRET=
