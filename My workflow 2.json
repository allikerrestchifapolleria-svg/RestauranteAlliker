    {
      "parameters": {
        "jsCode": "// 1. Extraemos el body donde están todos los datos de tu web\nconst payload = $input.first().json.body;\n\nif (!payload) {\n  return { error: \"No se encontró el body con los datos de la reserva\" };\n}\n\ntry {\n  // 2. Procesamos la fecha y hora para la alerta.\n  //    El offset -05:00 (Peru, sin horario de verano) va explicito: sin el,\n  //    new Date() usa la zona horaria del proceso de n8n y fecha_alerta se\n  //    desplaza segun la cuenta donde este importado el workflow.\n  const fechaCita = new Date(`${payload.date}T${payload.time}:00-05:00`);\n  \n  // 3. Restamos 1 minuto (para tu prueba de examen)\n  const tiempoAlerta = new Date(fechaCita.getTime() - 1 * 60000);\n\n  // 4. Retornamos el objeto LIMPIO con todos los campos necesarios\n  return {\n    firebaseId: payload.id, // <--- AGREGAMOS EL ID AQUÍ\n    restaurantId: payload.restaurantId,\n    branchId: payload.branchId,\n    branchName: payload.branchName,\n    tableId: payload.tableId,\n    tableName: payload.tableName,\n    customerName: payload.customerName,\n    customerPhone: payload.customerPhone,\n    customerEmail: payload.customerEmail,\n    date: payload.date,\n    time: payload.time,\n    peopleCount: payload.peopleCount,\n    specialRequests: payload.specialRequests,\n    status: payload.status,\n    // ISO-8601 completo, con la Z. Al quitarsela el nodo Wait la leia como\n    // hora local y volvia a desplazarla.\n    fecha_alerta: tiempoAlerta.toISOString()\n  };\n\n} catch (e) {\n  return { error: \"Error al procesar la fecha\", detalle: e instanceof Error ? e.message : String(e) };\n}"
      },
