    {
      "parameters": {
        "jsCode": "// 1. Extraemos el body donde están todos los datos de tu web\nconst payload = $input.item.json.body;\n\nif (!payload) {\n  return { error: \"No se encontró el body con los datos de la reserva\" };\n}\n\ntry {\n  // 2. Procesamos la fecha y hora para la alerta\n  const fechaCita = new Date(`${payload.date}T${payload.time}:00`);\n  \n  // 3. Restamos 1 minuto (para tu prueba de examen)\n  const tiempoAlerta = new Date(fechaCita.getTime() - 1 * 60000);\n\n  // 4. Retornamos el objeto LIMPIO con todos los campos necesarios\n  return {\n    firebaseId: payload.id, // <--- AGREGAMOS EL ID AQUÍ\n    restaurantId: payload.restaurantId,\n    branchId: payload.branchId,\n    branchName: payload.branchName,\n    tableId: payload.tableId,\n    tableName: payload.tableName,\n    customerName: payload.customerName,\n    customerPhone: payload.customerPhone,\n    customerEmail: payload.customerEmail,\n    date: payload.date,\n    time: payload.time,\n    peopleCount: payload.peopleCount,\n    specialRequests: payload.specialRequests,\n    status: payload.status,\n    // Formato de fecha limpio\n    fecha_alerta: tiempoAlerta.toISOString().split('.')[0].replace('T', ' ')\n  };\n\n} catch (e) {\n  return { error: \"Error al procesar la fecha\", detalle: e.message };\n}"
      },
